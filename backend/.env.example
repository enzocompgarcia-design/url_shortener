# Backend application environment variables
# Copy this file to .env in this directory (backend/.env) and adjust values as needed.
# This file is loaded by docker compose for the API services.

# Cassandra connection
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042

# Redis connection URL (must match the required REDIS_PASSWORD in the root .env)
REDIS_URL=redis://:change_me_redis_password@redis:6379/0

# Hashids/ID generation settings
SECRET_KEY=change_me_secret_key
ALPHABET=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789

# Redis key used as the ID counter and its initial value
NAME_CACHE_ID=url_shortener:id_counter
ID_START=1000

# Allowed CORS origins (JSON array)
ORIGINS=["http://localhost"]

# Rate limits for POST /link/ and GET /link/{code} (slowapi format)
# Raise these before running the load tests (test/read.js and test/write.js),
# otherwise most requests will receive HTTP 429.
RATE_LIMIT_WRITE=10/minute
RATE_LIMIT_READ=120/minute

# Optional timeouts (seconds) used by the /ready dependency checks
# CACHE_CHECK_TIMEOUT=2.0
# DATABASE_CHECK_TIMEOUT=2.0
